<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AUTO CLEAN | Gestión de Autolavado</title>
    <link rel="stylesheet" href="/estilos.css">
</head>
<body>

<header class="barra">
    <h2>🚘 AUTO CLEAN</h2>
    <nav>
        <a href="/app1/">Inicio</a>
        <a href="/app2/">Registrar servicio</a>
    </nav>
</header>

<main class="contenedor">

    <section class="bienvenida">
        <span class="etiqueta">SISTEMA DE GESTIÓN</span>
        <h1>Bienvenido a AUTO CLEAN</h1>
        <p>Administra tus clientes, vehículos y servicios de lavado.</p>
        <a class="boton" href="/app2/">+ Registrar servicio</a>
    </section>

    <section class="estadisticas">
        <article class="tarjeta">
            <h3>🚗 Servicios registrados</h3>
            <p id="cantidad">0</p>
        </article>

        <article class="tarjeta">
            <h3>💰 Ingresos totales</h3>
            <p id="ingresos">S/ 0.00</p>
        </article>

        <article class="tarjeta">
            <h3>🧽 Servicios disponibles</h3>
            <p>4</p>
        </article>
    </section>

    <section class="tarjeta">
        <h2>Servicios realizados</h2>

        <div class="tabla-contenedor">
            <table>
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Vehículo</th>
                        <th>Servicio</th>
                        <th>Precio</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody id="listaServicios">
                </tbody>
            </table>
        </div>
    </section>

</main>

<script src="/componentes/app.js"></script>
</body>
</html>
